# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit real secrets.

# Required to deploy or verify contracts.
PRIVATE_KEY=

# Required only for source verification on MSTScan.
MSTSCAN_API_KEY=

# Optional — enables WalletConnect in the frontend. Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional — powers automated (no-browser-wallet) issuance via the backend.
# Generate a dedicated wallet for this (never reuse PRIVATE_KEY above), then
# have the contract owner grant it issuer rights with setIssuer(address, true)
# from the Issuer Wallets panel before issuing through the backend.
ISSUER_PRIVATE_KEY=

# Optional — which deployment the backend issues against: "testnet" (default) or "mainnet".
NETWORK=testnet

# Optional — port the certificate backend listens on (defaults to 4100).
PORT=4100
